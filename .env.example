# Copy to .env (git-ignored) and edit. Used by compose.yaml.

# Required: password of the PostgreSQL role "quiz".
POSTGRES_PASSWORD=change-me

# Public origin used for QR links and Origin checks. It must match the URL
# students open. Session cookies need a secure context: http://localhost works,
# anything else needs HTTPS (use the "tls" profile).
QP_BASE_URL=http://localhost:8080

# Where the app port is published. 127.0.0.1 keeps it local; with the tls
# profile, Caddy is the only public entry point.
QP_HTTP_BIND=127.0.0.1:8080

# tls profile only.
#QP_DOMAIN=quiz.example.edu
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443
# Caddy gets a fixed address on the compose network so the app can trust its
# X-Forwarded-For (per-student rate limits). Change both only on a clash.
#QP_COMPOSE_SUBNET=172.31.250.0/24
#QP_CADDY_IP=172.31.250.10

# Swagger UI at /api/docs (0 disables).
QP_API_DOCS=1

# Optional SMTP relay for emails (password-reset etc.).
#QP_SMTP_ADDR=smtp.example.edu:587
#QP_SMTP_FROM=no-reply@example.edu
#QP_SMTP_USER=
# The SMTP password is read from a file (never an env var): mount it and set
# QP_SMTP_PASSWORD_FILE in compose.yaml.
