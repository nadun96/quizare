# Caddy for the compose "tls" profile (D-37). Same headers as deploy/Caddyfile;
# the app container serves the SPA itself, so everything is proxied.
# QP_DOMAIN: a public domain gets a Let's Encrypt certificate; "localhost" or an
# IP address gets a certificate from Caddy's internal CA (trust it on devices,
# or accept the warning once).
# No domain? A name like 203-0-113-5.sslip.io points at that IP and gets a
# Let's Encrypt certificate (see home.env.example).

{$QP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		# Add Strict-Transport-Security once a real domain is in use (not for localhost or an IP).
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' wss: {$QP_TUTORING_URL}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	reverse_proxy app:8080
}

# Tutoring (compose "tutoring" profile, D-59): its API and sockets go to the
# tutoring service, LiveKit's signalling (/rtc) to LiveKit. Media itself goes
# straight to LiveKit on UDP 7882.
{$QP_TUTOR_DOMAIN:tutor.localhost} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	@rtc path /rtc /rtc/*
	reverse_proxy @rtc livekit:7880
	reverse_proxy tutoring:8090
}

