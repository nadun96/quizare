# Caddy 2 (ADR-12): automatic HTTPS, HTTP/2+3, WebSocket proxying, precompressed static files.
# Replace quiz.example.edu with your domain and set QP_BASE_URL=https://quiz.example.edu.

# Tutoring's relay on port 443 (D-83, TS-NFR-12): connections for the relay's
# name go to LiveKit's TURN (deploy/livekit.yaml), with TLS ended here; every
# other name reaches the sites below as usual. This needs Caddy built with the
# layer4 plugin, e.g.
#   xcaddy build v2.11.7 --with github.com/mholt/caddy-l4@v0.1.2
# Without tutoring, or with a stock Caddy, delete this block and the
# turn.example.edu site at the end.
{
	servers :443 {
		listener_wrappers {
			layer4 {
				@turn tls sni turn.example.edu
				route @turn {
					tls
					proxy 127.0.0.1:5349
				}
			}
			tls
		}
	}
}

quiz.example.edu {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		# Strict CSP (ADR-16). Browsers enforce this header AND the <meta> CSP SvelteKit
		# writes into index.html; a script must satisfy both. The meta tag allows only
		# 'self' plus the hash of Kit's boot script, so no other inline script can run,
		# while 'unsafe-inline' here just avoids blocking that one hashed script.
		# img-src allows https: because resources are teacher-supplied public URLs
		# (BR-15), e.g. Google Drive thumbnails.
		# connect-src names the tutoring service (D-59); drop it if tutoring is off.
		# apis.google.com, the Google frames and connect-src googleapis are for
		# Google Drive's file picker (D-71); drop them if Drive is off.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; frame-src https://docs.google.com https://drive.google.com https://content.googleapis.com https://www.youtube-nocookie.com; connect-src 'self' wss: https://tutor.example.edu https://content.googleapis.com https://www.googleapis.com; media-src 'self' https://tutor.example.edu; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API, WebSockets and beacons go to the Go binary on loopback.
	@backend path /api/* /ws/* /beacon/* /healthz
	handle @backend {
		reverse_proxy 127.0.0.1:8080
	}

	# The SvelteKit static build (ADR-11).
	handle {
		root * /srv/quiz/frontend
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}

	log {
		output file /var/log/caddy/quiz-access.log
		format json
	}
}

# Tutoring (D-59): the tutoring service and LiveKit on their own subdomain.
# Its API and sockets go to the tutoring service; LiveKit's signalling (/rtc)
# goes to LiveKit. Media flows to LiveKit directly on UDP 7882 (TCP 7881 as a
# fallback), which the firewall must allow. Remove this block if tutoring is off.
tutor.example.edu {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	@rtc path /rtc /rtc/*
	reverse_proxy @rtc 127.0.0.1:7880
	reverse_proxy 127.0.0.1:8090
}

# The relay's name (D-83): this site only keeps its certificate; its
# connections are taken by the layer4 route at the top and never reach HTTP.
turn.example.edu {
	respond "Tutoring relay" 404
}
